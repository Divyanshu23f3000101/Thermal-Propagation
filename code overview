// =====================================================
// SETUP & LOOP
// =====================================================
void setup() {
  Serial.begin(115200);

  // I2C Pins
  Wire.begin(21, 22); 
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Shiksha Sopan");
  lcd.setCursor(0, 1);
  lcd.print("Connecting WiFi");

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(400);
    Serial.print(".");
  }

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("WiFi Connected!");
  lcd.setCursor(0, 1);
  lcd.print(WiFi.localIP().toString());
  
  delay(5000); 
  lcd.clear();

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.begin();
  Serial.println("\nHTTP Web Server started.");
}

void loop() {
  server.handleClient();

  static unsigned long lastSensorUpdate = 0;
  if (millis() - lastSensorUpdate >= 1000) {
    lastSensorUpdate = millis();

    // 1. Read temperature sensors
    for (int i = 0; i < NUM_SENSORS; i++) {
      currentTemps[i] = readSensorTemp(i);
      Serial.print(SENSOR_NAMES[i]);
      Serial.print(": ");
      Serial.print(currentTemps[i], 2);
      Serial.print(" C | ");
    }

    // 2. Read battery voltage and calculate percentage
    batteryVoltage = readBatteryVoltage();
    batteryPercentage = getBatteryPercentage(batteryVoltage);
    Serial.printf("Battery: %.2f V (%d%%)\n", batteryVoltage, batteryPercentage);

    // 3. LCD Formatting
    char row0[17];
    snprintf(row0, sizeof(row0), "%.1f  %.1f  %3d%%", currentTemps[0], currentTemps[1], batteryPercentage);
    lcd.setCursor(0, 0);
    lcd.print(row0);

    char row1[17];
    snprintf(row1, sizeof(row1), "%.1f  %.1f  %.1f", currentTemps[2], currentTemps[3], currentTemps[4]);
    lcd.setCursor(0, 1);
    lcd.print(row1);
  }

  // 4. Trigger non-blocking cloud upload every 15 seconds
  if (millis() - lastLogTime >= LOG_INTERVAL) {
    lastLogTime = millis();
    triggerSheetsUpload();
  }
}
