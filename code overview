const char* SENSOR_NAMES[NUM_SENSORS] = {"Temperature 1", "Temperature 2", "Temperature 3", "Temperature 4", "Temperature 5"};

// Target calibration offsets
const float TEMP_OFFSETS[NUM_SENSORS] = {
  4.3,    // T1
  6.5,    // T2
  5.3,    // T3
  2.0,    // T4
  2.4     // T5
};

// Battery voltage pin on ADC1 (VN pin / GPIO 39)
const int BATTERY_PIN = 39; 

// =====================================================
// NTC CONSTANTS
// =====================================================
const float VCC_MV    = 3300.0;    
const float R_FIXED   = 10000.0;   // 10k fixed resistor
const float R0        = 10000.0;   // 10k @ 25°C
const float T_REF     = 298.15;    // 25°C in Kelvin
const float BETA      = 3950.0;    
const int NUM_SAMPLES = 20;

float currentTemps[NUM_SENSORS] = {0};
float batteryVoltage = 0.0;
int batteryPercentage = 0;

// Background task handle & lock
