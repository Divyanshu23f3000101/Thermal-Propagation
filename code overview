// =====================================================
// SENSOR ACQUISITION FUNCTIONS
// =====================================================
float readSensorTemp(int index) {
  int pin = SENSOR_PINS[index];
  long totalRaw = 0;
  for (int i = 0; i < NUM_SAMPLES; i++) {
    totalRaw += analogRead(pin);
    delay(2);
  }
  float raw = totalRaw / (float)NUM_SAMPLES;

  // Convert raw 12-bit ADC (0 - 4095) to millivolts
  float vOut = (raw / 4095.0) * VCC_MV;

  // Safety floor set to 2.0 mV to support sub-zero ranges down to -35 °C
  if (vOut <= 2.0 || vOut >= (VCC_MV - 10.0)) return -999.0;

  float rNtc = R_FIXED * ((VCC_MV - vOut) / vOut);
  float tempK = 1.0 / ((1.0 / T_REF) + (1.0 / BETA) * log(rNtc / R0));
  float rawTempC = tempK - 273.15;

  return rawTempC + TEMP_OFFSETS[index];
}

float readBatteryVoltage() {
  const int SAMPLES = 30;
  long totalRaw = 0;

  for (int i = 0; i < SAMPLES; i++) {
    totalRaw += analogRead(BATTERY_PIN);
    delay(2);
  }
  float rawAvg = totalRaw / (float)SAMPLES;

  // 12-bit ADC conversion across 3.3V reference
  float pinVoltage = (rawAvg / 4095.0) * 3.3;
  float currentSample = pinVoltage * 3.09;

  static float filteredVolts = 0.0;

  if (filteredVolts == 0.0) {
    filteredVolts = currentSample;
    return filteredVolts;
  }

  // Reject sudden charger switching noise spikes (>0.30V delta)
  if (abs(currentSample - filteredVolts) > 0.30) {
    return filteredVolts; 
  }

  // Low-pass exponential moving average filter
  filteredVolts = (0.85 * filteredVolts) + (0.15 * currentSample);

  return filteredVolts;
}

int getBatteryPercentage(float voltage) {
  if (voltage >= 8.00) return 100;
  if (voltage <= 6.70) return 0;
  
  int pct = (int)(((voltage - 6.70) / 1.30) * 100.0);
  return constrain(pct, 0, 100);
}

// =====================================================
// ASYNC GOOGLE SHEETS TASK (RUNS ON CORE 0)
// =====================================================
void sheetsUploadTask(void *pvParameters) {
  if (WiFi.status() == WL_CONNECTED) {
    WiFiClientSecure client;
    client.setInsecure(); // Skip certificate verification
    client.setTimeout(15);

    HTTPClient https;
    String url = "https://script.google.com/macros/s/" + GOOGLE_SCRIPT_ID + "/exec?";
    url += "t1=" + String(currentTemps[0], 2);
    url += "&t2=" + String(currentTemps[1], 2);
    url += "&t3=" + String(currentTemps[2], 2);
    url += "&t4=" + String(currentTemps[3], 2);
    url += "&t5=" + String(currentTemps[4], 2);
    url += "&batt=" + String(batteryVoltage, 2);
    url += "&pct=" + String(batteryPercentage);

    if (https.begin(client, url)) {
      https.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
      https.addHeader("User-Agent", "ESP32");
      https.addHeader("Connection", "close");

      int httpCode = https.GET();
      if (httpCode > 0) {
        Serial.printf("[Google Sheets] Logged successfully (HTTP %d)\n", httpCode);
      } else {
        Serial.printf("[Google Sheets] Request failed: %s\n", https.errorToString(httpCode).c_str());
      }
      https.end();
    } else {
      Serial.println("[Google Sheets] Unable to configure SSL connection");
    }
  } else {
    Serial.println("[Google Sheets] Skipped: Wi-Fi offline");
  }

  isLoggingActive = false;
  vTaskDelete(NULL);
}

void triggerSheetsUpload() {
  if (!isLoggingActive) {
    isLoggingActive = true;
    xTaskCreatePinnedToCore(
      sheetsUploadTask,
      "SheetsTask",
      8192,
      NULL,
      1,
      &sheetsTaskHandle,
      0
    );
  }
}

